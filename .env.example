# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...           # OpenAI API key for GPT-4o

# ── Voice (TTS) ───────────────────────────────────────────────────────────────
FISH_AUDIO_KEY=                 # Fish.audio API key  (leave blank → pyttsx3 fallback)
FISH_AUDIO_VOICE_ID=            # (optional) Fish.audio reference/voice ID

# ── Web search ────────────────────────────────────────────────────────────────
BRAVE_API_KEY=                  # Brave Search API key  (leave blank → search disabled)
