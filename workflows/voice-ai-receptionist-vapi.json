    {
      "parameters": {
        "jsCode": "// Parse caller's requested date/time from message\nconst message = $input.first().json.caller_message.toLowerCase();\nconst existingEvents = $input.all().slice(1); // Calendar events from second input\n\n// Extract date/time intent from message (simplified - you can enhance with better NLP)\nlet requestedDate = new Date();\nlet requestedHour = 10; // Default to 10 AM\n\n// Check if message mentions specific days\nif (message.includes('tomorrow')) {\n  requestedDate.setDate(requestedDate.getDate() + 1);\n} else if (message.includes('monday')) {\n  const today = requestedDate.getDay();\n  const daysUntilMonday = (1 - today + 7) % 7 || 7;\n  requestedDate.setDate(requestedDate.getDate() + daysUntilMonday);\n} else if (message.includes('tuesday')) {\n  const today = requestedDate.getDay();\n  const daysUntilTuesday = (2 - today + 7) % 7 || 7;\n  requestedDate.setDate(requestedDate.getDate() + daysUntilTuesday);\n} else if (message.includes('wednesday')) {\n  const today = requestedDate.getDay();\n  const daysUntilWed = (3 - today + 7) % 7 || 7;\n  requestedDate.setDate(requestedDate.getDate() + daysUntilWed);\n} else if (message.includes('thursday')) {\n  const today = requestedDate.getDay();\n  const daysUntilThu = (4 - today + 7) % 7 || 7;\n  requestedDate.setDate(requestedDate.getDate() + daysUntilThu);\n} else if (message.includes('friday')) {\n  const today = requestedDate.getDay();\n  const daysUntilFri = (5 - today + 7) % 7 || 7;\n  requestedDate.setDate(requestedDate.getDate() + daysUntilFri);\n}\n\n// Extract time if mentioned\nconst timeMatch = message.match(/(\\d{1,2})\\s*(am|pm|a\\.m\\.|p\\.m\\.)/i);\nif (timeMatch) {\n  requestedHour = parseInt(timeMatch[1]);\n  if (timeMatch[2].toLowerCase().includes('pm') && requestedHour !== 12) {\n    requestedHour += 12;\n  }\n  if (timeMatch[2].toLowerCase().includes('am') && requestedHour === 12) {\n    requestedHour = 0;\n  }\n}\n\n// Set requested appointment time\nrequested = new Date(requestedDate);\nrequested.setHours(requestedHour, 0, 0, 0);\n\n// Check for conflicts\nconst appointmentDuration = 60 * 60 * 1000; // 1 hour in milliseconds\nconst requestedEnd = new Date(requested.getTime() + appointmentDuration);\n\nlet hasConflict = false;\nlet conflictingEvent = null;\n\nfor (const event of existingEvents) {\n  if (event.json.status === 'cancelled') continue;\n  \n  const eventStart = new Date(event.json.start.dateTime || event.json.start.date);\n  const eventEnd = new Date(event.json.end.dateTime || event.json.end.date);\n  \n  // Check for overlap\n  if (requested < eventEnd && requestedEnd > eventStart) {\n    hasConflict = true;\n    conflictingEvent = event.json;\n    break;\n  }\n}\n\n// Find alternative slots if there's a conflict\nconst alternatives = [];\nif (hasConflict) {\n  // Generate 3 alternative time slots\n  for (let i = 1; i <= 3; i++) {\n    const altDate = new Date(requested);\n    altDate.setHours(requested.getHours() + (i * 2)); // 2 hours apart\n    \n    const altEnd = new Date(altDate.getTime() + appointmentDuration);\n    let altConflict = false;\n    \n    for (const event of existingEvents) {\n      if (event.json.status === 'cancelled') continue;\n      const eventStart = new Date(event.json.start.dateTime || event.json.start.date);\n      const eventEnd = new Date(event.json.end.dateTime || event.json.end.date);\n      \n      if (altDate < eventEnd && altEnd > eventStart) {\n        altConflict = true;\n        break;\n      }\n    }\n    \n    if (!altConflict) {\n      alternatives.push({\n        start: altDate.toISOString(),\n        end: altEnd.toISOString(),\n        formatted: altDate.toLocaleString('en-US', { \n          weekday: 'long', \n          hour: 'numeric', \n          minute: '2-digit',\n          hour12: true \n        })\n      });\n    }\n  }\n}\n\nreturn {\n  requested_start: requested.toISOString(),\n  requested_end: requestedEnd.toISOString(),\n  has_conflict: hasConflict,\n  conflicting_event: conflictingEvent,\n  alternative_slots: alternatives,\n  can_book: !hasConflict\n};"
      },
