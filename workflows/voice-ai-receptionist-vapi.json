      "parameters": {
        "jsCode": "// Format response for Vapi to speak to caller\nconst appointmentData = $input.first().json;\nconst callerData = $('Extract Call Data').item.json;\n\nconst startTime = new Date(appointmentData.start.dateTime);\nconst formattedTime = startTime.toLocaleString('en-US', {\n  weekday: 'long',\n  month: 'long',\n  day: 'numeric',\n  hour: 'numeric',\n  minute: '2-digit',\n  hour12: true\n});\n\nreturn {\n  response: {\n    type: 'assistant-response',\n    message: `Perfect! I've booked your appointment for ${formattedTime}. You'll receive a confirmation email shortly. Is there anything else I can help you with?`,\n    action: 'appointment_booked',\n    appointment: {\n      id: appointmentData.id,\n      start: appointmentData.start.dateTime,\n      end: appointmentData.end.dateTime,\n      link: appointmentData.htmlLink\n    }\n  }\n};"
      },
      "id": "format-booking-success",
      "name": "Format Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 80]
    },
    {
      "parameters": {
        "jsCode": "// Format response with alternative time slots\nconst availabilityData = $input.first().json;\nconst callerData = $('Extract Call Data').item.json;\n\nlet message = \"I'm sorry, but that time slot is already booked. \";\n\nif (availabilityData.alternative_slots && availabilityData.alternative_slots.length > 0) {\n  message += \"Here are some alternative times I have available: \";\n  \n  availabilityData.alternative_slots.forEach((slot, index) => {\n    if (index === 0) {\n      message += slot.formatted;\n    } else if (index === availabilityData.alternative_slots.length - 1) {\n      message += `, or ${slot.formatted}`;\n    } else {\n      message += `, ${slot.formatted}`;\n    }\n  });\n  \n  message += \". Which time works best for you?\";\n} else {\n  message += \"Let me check my calendar for other available times. What dates work for you?\";\n}\n\nreturn {\n  response: {\n    type: 'assistant-response',\n    message: message,\n    action: 'suggest_alternatives',\n    alternatives: availabilityData.alternative_slots\n  }\n};"
      },
